diff --git a/packages/game-engine/test/match/forced-substitution.test.ts b/packages/game-engine/test/match/forced-substitution.test.ts
new file mode 100644
index 0000000..0cef49c
--- /dev/null
+++ b/packages/game-engine/test/match/forced-substitution.test.ts
@@ -0,0 +1,142 @@
+import { describe, expect, it } from "vitest";
+import type { MatchEvent, SubstitutionEvent } from "../../src/match/events.js";
+import { simulateMatch } from "../../src/match/simulate/index.js";
+import { applyCommand, forcePlayerOff, initTeamState, type TeamRuntimeState } from "../../src/match/simulate/teamState.js";
+import type { MatchTeamSetup } from "../../src/match/types.js";
+import { buildTeam, clubId as makeClubId } from "./fixtures.js";
+import type { PlayerId } from "@cm-clone/contracts";
+
+/**
+ * Who a forced substitution brings on (group-g-match-day ticket 26): a squad player who has never
+ * been on the pitch, the first by player id, whatever order the squad arrives in.
+ */
+const HOME = makeClubId("home");
+
+const onPitch = (team: TeamRuntimeState): ReadonlyArray<PlayerId> => team.resolved.slots.map((slot) => slot.playerId);
+
+const forcedSubstitutions = (events: ReadonlyArray<MatchEvent>): ReadonlyArray<SubstitutionEvent> =>
+  events.filter((event): event is SubstitutionEvent => event._tag === "Substitution" && event.forcedByInjury);
+
+/** The squad players who have never been on the pitch, in player id order. */
+const neverOn = (setup: MatchTeamSetup, beenOn: ReadonlyArray<PlayerId>): ReadonlyArray<PlayerId> =>
+  setup.squad
+    .map((player) => player.id)
+    .filter((id) => !setup.tactic.slots.some((slot) => slot.playerId === id) && !beenOn.includes(id))
+    .sort((a, b) => (a < b ? -1 : a > b ? 1 : 0));
+
+/** Seed 7's generated squad: 11 starters and a bench to choose from. */
+const setupOf = (): MatchTeamSetup => buildTeam(HOME, 7).setup;
+
+const outfielder = (setup: MatchTeamSetup, index: number): PlayerId => setup.tactic.slots[index]!.playerId;
+
+describe("forcePlayerOff's replacement", () => {
+  it("brings on the first never-on squad player by player id", () => {
+    const setup = setupOf();
+    const team = initTeamState(setup);
+    const events: Array<MatchEvent> = [];
+
+    forcePlayerOff(team, outfielder(setup, 5), 30, 1, events);
+
+    expect(forcedSubstitutions(events).map((event) => event.inPlayerId)).toEqual([neverOn(setup, [])[0]]);
+  });
+
+  it("does not bring back a player the manager substituted off", () => {
+    const setup = setupOf();
+    const team = initTeamState(setup);
+    const substitutedOff = outfielder(setup, 5);
+    const first = neverOn(setup, [])[0]!;
+    // The first candidate comes on and goes off again in one window: the pitch is back to its starters.
+    expect(applyCommand(team, { _tag: "MakeSubstitution", clubId: HOME, outPlayerId: substitutedOff, inPlayerId: first }, 20, false).accepted).toBe(true);
+    expect(applyCommand(team, { _tag: "MakeSubstitution", clubId: HOME, outPlayerId: first, inPlayerId: substitutedOff }, 20, false).accepted).toBe(true);
+    const events: Array<MatchEvent> = [];
+
+    forcePlayerOff(team, outfielder(setup, 6), 30, 1, events);
+
+    const [forced] = forcedSubstitutions(events);
+    expect(forced?.inPlayerId).not.toBe(first);
+    expect(forced?.inPlayerId).toBe(neverOn(setup, [first])[0]);
+  });
+
+  it("does not bring on a player who was sent off or injured off", () => {
+    const setup = setupOf();
+    const team = initTeamState(setup);
+    const first = neverOn(setup, [])[0]!;
+    const events: Array<MatchEvent> = [];
+    // The first candidate comes on for a severe injury and is then sent off: the next forced
+    // substitution must skip both him and the injured player he replaced.
+    forcePlayerOff(team, outfielder(setup, 5), 30, 1, events);
+    expect(onPitch(team)).toContain(first);
+    // A red card removes the slot outright (`resolveCards`); model that the same way.
+    team.resolved.slots = team.resolved.slots.filter((slot) => slot.playerId !== first);
+    forcePlayerOff(team, outfielder(setup, 6), 31, 1, events);
+
+    const inPlayers = forcedSubstitutions(events).map((event) => event.inPlayerId);
+    expect(inPlayers).toEqual([first, neverOn(setup, [first])[0]]);
+    expect(inPlayers).not.toContain(outfielder(setup, 5));
+  });
+
+  it("picks the same replacement whatever order the squad is in", () => {
+    const setup = setupOf();
+    const reversed: MatchTeamSetup = { ...setup, squad: [...setup.squad].reverse() };
+    const rotated: MatchTeamSetup = { ...setup, squad: [...setup.squad.slice(7), ...setup.squad.slice(0, 7)] };
+
+    const replacements = [setup, reversed, rotated].map((variant) => {
+      const team = initTeamState(variant);
+      const events: Array<MatchEvent> = [];
+      forcePlayerOff(team, outfielder(variant, 5), 30, 1, events);
+      return forcedSubstitutions(events).map((event) => event.inPlayerId);
+    });
+
+    expect(replacements[1]).toEqual(replacements[0]);
+    expect(replacements[2]).toEqual(replacements[0]);
+  });
+
+  it("leaves the slot empty when every squad player has been on", () => {
+    const setup = setupOf();
+    const starters = new Set(setup.tactic.slots.map((slot) => slot.playerId));
+    // Twelve players: the eleven starters and one substitute, who has already come on and gone off.
+    const substitute = neverOn(setup, [])[0]!;
+    const small: MatchTeamSetup = { ...setup, squad: setup.squad.filter((p) => starters.has(p.id) || p.id === substitute) };
+    const team = initTeamState(small);
+    expect(applyCommand(team, { _tag: "MakeSubstitution", clubId: HOME, outPlayerId: outfielder(small, 5), inPlayerId: substitute }, 20, false).accepted).toBe(true);
+    expect(applyCommand(team, { _tag: "MakeSubstitution", clubId: HOME, outPlayerId: substitute, inPlayerId: outfielder(small, 5) }, 20, false).accepted).toBe(true);
+    const events: Array<MatchEvent> = [];
+
+    forcePlayerOff(team, outfielder(small, 6), 30, 1, events);
+
+    expect(events).toEqual([]);
+    expect(onPitch(team)).toHaveLength(10);
+    expect(onPitch(team)).not.toContain(outfielder(small, 6));
+    expect(team.substitutionsUsed).toBe(2);
+  });
+});
+
+describe("a simulated match with a forced substitution", () => {
+  /** The first seed whose match forces a substitution for the home side. */
+  const seedWithForcedSubstitution = (): number => {
+    for (let seed = 1; seed < 2000; seed++) {
+      const events = simulateMatch({ seed, home: buildTeam(HOME, seed).setup, away: buildTeam(makeClubId("away"), seed + 1000).setup });
+      if (forcedSubstitutions(events).some((event) => event.teamClubId === HOME)) return seed;
+    }
+    throw new Error("no seed forces a home substitution");
+  };
+
+  it("replays identically with the squads in any order", () => {
+    const seed = seedWithForcedSubstitution();
+    const home = buildTeam(HOME, seed).setup;
+    const away = buildTeam(makeClubId("away"), seed + 1000).setup;
+
+    const inOrder = simulateMatch({ seed, home, away });
+    const reversed = simulateMatch({
+      seed,
+      home: { ...home, squad: [...home.squad].reverse() },
+      away: { ...away, squad: [...away.squad].reverse() },
+    });
+
+    expect(reversed).toEqual(inOrder);
+    const starters = new Set(home.tactic.slots.map((slot) => slot.playerId));
+    for (const event of forcedSubstitutions(inOrder).filter((e) => e.teamClubId === HOME)) {
+      expect(starters.has(event.inPlayerId)).toBe(false);
+    }
+  });
+});
