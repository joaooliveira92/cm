+import { continueSeededCareer, expect, goto, test } from "./launchApp.js";
+import { savesDir, seedFresh } from "./seedSaves.js";
+
+/**
+ * Contract Renewal's path (Screen 140, group-j ticket 04). A fresh save stands in the pre-season, so
+ * its Transfer Window is open and a renewal is legal with no played Matchday. No in-app control links
+ * to the Player Contract route yet, so the spec reaches a real own-club Player through the Training
+ * Overview's plan preview and the Individual Training Plan (whose URL carries the player id) and then opens
+ * `/player/$playerId/contract` by address, as `performance-report.spec.ts` does.
+ *
+ * The spec picks a length other than the current one, renews, and sees the contract re-read with it.
+ * That no action shows for another club's Player is proven in `player-contract-screen.test.tsx`.
+ */
+test("the Player Contract screen renews an own-club Player's Contract for a chosen length", async ({
+  window: page,
+  userDataDir,
+}) => {
+  await seedFresh(savesDir(userDataDir));
+  await continueSeededCareer(page, "Seed: fresh");
+
+  await goto(page, "training");
+  const firstRow = page.getByRole("list", { name: "Training plan preview" }).getByRole("listitem").first();
+  const playerName = await firstRow.getByRole("heading", { level: 3 }).innerText();
+  expect(playerName.length).toBeGreaterThan(0);
+  await firstRow.getByRole("button", { name: `${playerName} training plan`, exact: true }).click();
+  await expect(page.getByRole("heading", { name: `${playerName} — Training Plan`, level: 1 })).toBeVisible();
+
+  await page.evaluate(() => {
+    location.hash = location.hash.replace(/\/training\/plan\/([^/?]+)/, "/player/$1/contract");
+  });
+
+  const main = page.getByRole("main", { name: "Player Contract" });
+  const length = main.getByText(/^Length: \d+ years?$/);
+  await expect(length).toBeVisible();
+  const current = Number((await length.innerText()).match(/(\d+)/)![1]);
+  const chosen = current === 5 ? 4 : 5;
+
+  const renewal = main.getByRole("region", { name: "Renew contract" });
+  await expect(renewal).toBeVisible();
+  await renewal.getByRole("combobox", { name: "Contract length" }).click();
+  await page.getByRole("listbox").getByRole("option", { name: `${chosen} years`, exact: true }).click();
+  await expect(page.getByRole("listbox")).toHaveCount(0);
+  await renewal.getByRole("button", { name: "Renew", exact: true }).click();
+
+  await expect(main.getByText(`Length: ${chosen} years`, { exact: true })).toBeVisible();
+  await expect(main.getByText(/^Expires: Season \d+$/)).toBeVisible();
+  await expect(renewal.getByRole("alert")).toHaveCount(0);
+});
