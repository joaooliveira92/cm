{
  "name": "cm-clone",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @cm-clone/desktop dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint .",
    "effect-lint": "tsx scripts/effect-lint.ts",
    "verify-md-links": "tsx scripts/verify-md-links.ts",
    "resolve-ticket": "tsx scripts/resolve-ticket.ts",
    "check:all": "tsx scripts/run-gates.ts check-all",
    "check:ci": "tsx scripts/run-gates.ts ci",
    "prepare": "effect-tsgo patch --typescript --oxlint"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "devDependencies": {
    "@effect/tsgo": "0.38.0",
    "@effect/tsgo-darwin-arm64": "0.38.0",
    "@typescript/typescript-darwin-arm64": "7.0.2",
    "oxlint": "^1.80.0",
    "tsx": "^4.23.12",
    "typescript": "7.0.2"
  }
}
