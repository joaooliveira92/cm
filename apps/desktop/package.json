{
  "name": "@cm-clone/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently -k -n main,preload,renderer,electron \"pnpm build:main --watch\" \"pnpm build:preload --watch\" \"vite -c vite.renderer.config.ts\" \"node scripts/dev-electron.mjs\"",
    "build:main": "vite build -c vite.main.config.ts",
    "build:preload": "vite build -c vite.preload.config.ts",
    "build:renderer": "vite build -c vite.renderer.config.ts",
    "build": "pnpm build:main && pnpm build:preload && pnpm build:renderer",
    "db:generate": "rm -rf drizzle && drizzle-kit generate --name schema && tsx scripts/generate-migrations.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pretest:e2e": "pnpm build",
    "test:e2e": "playwright test",
    "electron": "electron .",
    "package": "pnpm build && electron-builder --config electron-builder.yml"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@cm-clone/contracts": "workspace:*",
    "@cm-clone/game-engine": "workspace:*",
    "@cm-clone/shared": "workspace:*",
    "@effect/atom-react": "catalog:",
    "@effect/sql-sqlite-node": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-table": "catalog:",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.2",
    "effect": "catalog:",
    "lucide-react": "^1.37.0",
    "motion": "^13.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hotkeys-hook": "catalog:",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "catalog:",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.0",
    "drizzle-kit": "^0.31.10",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.3.3",
    "vite": "^7.0.0",
    "vitest": "^4.1.0"
  }
}
